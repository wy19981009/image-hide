<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ 媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ 部分授权 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      所有文件访问：开启后隐藏时可直接删除系统媒体，无需每次点「允许」。
      仅适合自用 / 侧载；Google Play 对普通相册类 App 通常不允许此权限。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 后台任务 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 启动接收 WorkManager -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 指纹 / 面容解锁 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".ImageHideApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImageHide"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.ImageHide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ★ Android 14 (API 34) 起，targetSdk >= 34 时 startForeground() 必须带
              foregroundServiceType，且该类型必须是 Manifest 里 <service> 声明过的子集。
              WorkManager 自带的 SystemForegroundService 在库 Manifest 里没有声明
              foregroundServiceType（合并后 = 0x00000000），所以 Worker 里 setForeground()
              会抛：
                IllegalArgumentException: foregroundServiceType 0x00000001 is not a subset of
                foregroundServiceType attribute 0x00000000 in service element of manifest file
              → SystemForegroundService crash → 整个 APP 进程被杀（表现为「闪退」）。
              这里用 tools:node="merge" 给库里的 service 补上类型声明。
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />

        <!-- WorkManager 初始化：禁用默认初始化，使用 Hilt + Configuration.Provider -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
